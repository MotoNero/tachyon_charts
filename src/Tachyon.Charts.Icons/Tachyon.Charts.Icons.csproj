<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Description>Material Symbols as signs of annotations in Tachyon Charts: vector symbols, sharp at every size, in any color.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>charts;icons;symbols</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Tachyon.Charts.Core/Tachyon.Charts.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <!-- Material Symbols Outlined 2.978, Apache-2.0: the font gzip-packed, the names of its symbols with their code points. -->
    <EmbeddedResource Include="Fonts/MaterialSymbolsOutlined.ttf.gz" LogicalName="MaterialSymbolsOutlined.ttf.gz" />
    <EmbeddedResource Include="Fonts/MaterialSymbolsOutlined.codepoints" LogicalName="MaterialSymbolsOutlined.codepoints" />
    <!-- The outlines for previews, made with tools/icons/make-paths.cs, so that the package needs no SkiaSharp. -->
    <EmbeddedResource Include="Fonts/MaterialSymbolsOutlined.paths.gz" LogicalName="MaterialSymbolsOutlined.paths.gz" />
    <None Include="Fonts/LICENSE-MaterialSymbols.txt" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
