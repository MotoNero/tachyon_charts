<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>HDF5 datasets for Tachyon Charts: converted block by block into column files that open at once, whatever their size.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>charts;hdf5;large-data</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Tachyon.Charts.Core/Tachyon.Charts.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PureHDF 2.2.0, MIT, managed only; already the reader of the configurator. -->
    <PackageReference Include="PureHDF" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
