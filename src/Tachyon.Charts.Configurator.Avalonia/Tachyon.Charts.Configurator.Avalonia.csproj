<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <!-- Installable with "dotnet tool install -g Tachyon.Charts.Configurator.Tool"; runs on Windows, Linux and macOS. -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tachyon-configurator</ToolCommandName>
    <PackageId>Tachyon.Charts.Configurator.Tool</PackageId>
    <Description>The Tachyon Charts configurator: put a chart together, see it, and copy its C#, view model, window and project.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../docs/images/logo/app/tachyon-charts.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The logo: the icon of the window and the file, and the lockup at the top of the sidebar. -->
    <EmbeddedResource Include="../../docs/images/logo/app/tachyon-charts.ico" LogicalName="Logo.ico" Link="Logo/tachyon-charts.ico" />
    <EmbeddedResource Include="../../docs/images/logo/app/tachyon-charts-sidebar.png" LogicalName="Logo.Sidebar.png" Link="Logo/tachyon-charts-sidebar.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tachyon.Charts.AvaloniaHostTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The logo, shared as source with the showroom. -->
    <Compile Include="../../samples/Tachyon.Charts.Samples.Avalonia/AppLogo.cs" Link="AppLogo.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Tachyon.Charts.Configurator/Tachyon.Charts.Configurator.csproj" />
    <ProjectReference Include="../Tachyon.Charts.Configurator.ThreeD/Tachyon.Charts.Configurator.ThreeD.csproj" />
    <ProjectReference Include="../Tachyon.Charts.Configurator.Medical/Tachyon.Charts.Configurator.Medical.csproj" />
    <ProjectReference Include="../Tachyon.Charts.Avalonia/Tachyon.Charts.Avalonia.csproj" />
  </ItemGroup>

  <!-- The tool leaves out the debug symbols of the native libraries, about 90 MB that a user does not need. -->
  <Target Name="LeaveOutNativeSymbols" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb' And $([System.String]::Copy('%(RelativePath)').StartsWith('runtimes'))" />
    </ItemGroup>
  </Target>

</Project>
