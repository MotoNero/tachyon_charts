<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <RootNamespace>Tachyon.Charts.Configurator.Wpf</RootNamespace>
    <ApplicationIcon>../../docs/images/logo/app/tachyon-charts.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The logo: the icon of the window and the file, and the lockup at the top of the sidebar. -->
    <EmbeddedResource Include="../../docs/images/logo/app/tachyon-charts.ico" LogicalName="Logo.ico" Link="Logo/tachyon-charts.ico" />
    <EmbeddedResource Include="../../docs/images/logo/app/tachyon-charts-sidebar.png" LogicalName="Logo.Sidebar.png" Link="Logo/tachyon-charts-sidebar.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tachyon.Charts.Wpf.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Tachyon.Charts.Configurator/Tachyon.Charts.Configurator.csproj" />
    <ProjectReference Include="../Tachyon.Charts.Configurator.ThreeD/Tachyon.Charts.Configurator.ThreeD.csproj" />
    <ProjectReference Include="../Tachyon.Charts.Configurator.Medical/Tachyon.Charts.Configurator.Medical.csproj" />
    <ProjectReference Include="../Tachyon.Charts.Wpf/Tachyon.Charts.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The look of the showroom, shared as source. -->
    <Compile Include="../../samples/Tachyon.Charts.Samples.Wpf/SampleStyle.cs" Link="SampleStyle.cs" />
  </ItemGroup>

</Project>
