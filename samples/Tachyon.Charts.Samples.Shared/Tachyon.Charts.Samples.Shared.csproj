<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- The showroom shows the code of each page: the sources of this project travel along. -->
  <ItemGroup>
    <EmbeddedResource Include="**/*.cs" Exclude="bin/**;obj/**;Spikes/**" LogicalName="Source/Shared/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Files an example reads, such as the themes of the page "Own theme"; the XAML files are compiled by the apps. -->
    <EmbeddedResource Include="Examples/**/*.json;Examples/**/*.xaml;Examples/**/*.axaml" LogicalName="Source/Shared/Examples/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Tachyon.Charts.Core/Tachyon.Charts.Core.csproj" />
    <ProjectReference Include="../../src/Tachyon.Charts.Export/Tachyon.Charts.Export.csproj" />
    <ProjectReference Include="../../src/Tachyon.Charts.Medical/Tachyon.Charts.Medical.csproj" />
    <ProjectReference Include="../../src/Tachyon.Charts.ThreeD/Tachyon.Charts.ThreeD.csproj" />
    <ProjectReference Include="../../src/Tachyon.Charts.ThreeD.Files/Tachyon.Charts.ThreeD.Files.csproj" />
    <ProjectReference Include="../../src/Tachyon.Charts.Rendering.Skia/Tachyon.Charts.Rendering.Skia.csproj" />
    <ProjectReference Include="../../src/Tachyon.Charts.Rendering.WebGPU/Tachyon.Charts.Rendering.WebGPU.csproj" />
  </ItemGroup>

</Project>
