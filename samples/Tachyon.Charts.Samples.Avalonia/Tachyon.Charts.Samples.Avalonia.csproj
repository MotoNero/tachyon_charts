<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Raw bitmap memory for the still scenes. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>../../docs/images/logo/app/tachyon-charts.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The logo: the icon of the window and the file, and the lockup at the top of the sidebar. -->
    <EmbeddedResource Include="../../docs/images/logo/app/tachyon-charts.ico" LogicalName="Logo.ico" Link="Logo/tachyon-charts.ico" />
    <EmbeddedResource Include="../../docs/images/logo/app/tachyon-charts-sidebar.png" LogicalName="Logo.Sidebar.png" Link="Logo/tachyon-charts-sidebar.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Tachyon.Charts.ThreeD.Avalonia/Tachyon.Charts.ThreeD.Avalonia.csproj" />
    <ProjectReference Include="../../src/Tachyon.Charts.Avalonia/Tachyon.Charts.Avalonia.csproj" />
    <ProjectReference Include="../Tachyon.Charts.Samples.Shared/Tachyon.Charts.Samples.Shared.csproj" />
  </ItemGroup>

</Project>
