<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- The 3D add-on has a version of its own; tools/release/release.sh sets it with -p:ThreeDVersion. -->
  <PropertyGroup Condition="'$(ThreeDVersion)' != '' and $(MSBuildProjectName.StartsWith('Tachyon.Charts.ThreeD'))">
    <PackageVersion>$(ThreeDVersion)</PackageVersion>
    <InformationalVersion>$(ThreeDVersion)</InformationalVersion>
  </PropertyGroup>

  <!-- The medical add-on has a version of its own; tools/release/release.sh sets it with -p:MedicalVersion. -->
  <PropertyGroup Condition="'$(MedicalVersion)' != '' and $(MSBuildProjectName.StartsWith('Tachyon.Charts.Medical'))">
    <PackageVersion>$(MedicalVersion)</PackageVersion>
    <InformationalVersion>$(MedicalVersion)</InformationalVersion>
  </PropertyGroup>

</Project>
